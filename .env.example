GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Reads photos only when Gemma rejects them (paid, ~US$0.0005 a photo). Set to off to disable.
PHOTO_FALLBACK_MODEL=gemini-3.1-flash-lite
DEVDRAFT_BASE_URL=https://api.devdraft.ai
DEVDRAFT_CLIENT_KEY=
DEVDRAFT_CLIENT_SECRET=
# Choose any long random string; it is registered with DevDraft by `npm run webhook:register`
DEVDRAFT_WEBHOOK_SECRET=
# Optional: base URL for checkout if the payment-link response has no absolute URL
DEVDRAFT_CHECKOUT_BASE=
ZMW_PER_USD=25
DEMO_MAX_USD=5
PUBLIC_BASE_URL=http://localhost:3000
# Set to 1 to allow simulated payments even when DevDraft is connected
ALLOW_SIMULATE=
# Set to "mock" to use the built-in simulated DevDraft (labelled in the UI); leave empty for the real API
DEVDRAFT_MODE=
# Hosted database (Turso / libSQL). Leave empty to use a local SQLite file in ./data
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
